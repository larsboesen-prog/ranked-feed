+function syCard(r,inn){
+  const st=r.key&&HOURS[r.key]?status(r.key):null;
+  const s=inn>0?`<span class="st-soon">${escH(SYT("opens",{t:hm(nowMX().m+inn),m:mins(inn)}))}</span>`
+    :st?`<span class="${st.cls}">${escH(st.text)}</span>`:`<span class="sy-nh">${escH(SYT("nohours"))}</span>`;
+  const onPage=r.id&&byId[r.id]&&STATUS[r.id]!=="CLOSED_PERMANENTLY";
+  return `<div class="sy-card"><b>${escH(r.name)}</b>${r.area?`<span class="sy-a">${escH(r.area)}</span>`:""}
+    <div class="sy-n">${escH(window.LANG==="es"&&r.note_es||r.note)}</div>
+    <div class="sy-s">${s}${r.hours_from&&st?`<small>${escH(SYT("fromPost"))}</small>`:""}</div>
+    <div class="sy-m"><span>${escH(shortDate(r.date))}</span><a href="${escH(r.url)}" target="_blank" rel="noopener">${escH(SYT("review"))}</a>${onPage?`<button class="sy-open" data-id="${escH(r.id)}">${escH(SYT("card"))}</button>`:`<a href="${escH(syMaps(r))}" target="_blank" rel="noopener">${escH(T("Directions ↗"))}</a>`}</div></div>`;
+}
+let syAll=false;
+function renderSusan(){
+  const el=document.getElementById("susan"); if(!el) return;
+  if(!SY.length||query){ el.innerHTML=""; return; }
+  const rows=SY.map((r,i)=>({r,i,inn:opensIn(r.key)}));
+  const show=syAll?rows:rows.filter(x=>x.inn!==null).sort((a,b)=>a.inn-b.inn||a.i-b.i);
+  el.innerHTML=`<div class="sy-h"><div><b>${escH(SYT("head"))}</b><small>${escH(SYT(syAll?"suball":"sub"))}</small></div><button class="sy-all">${escH(SYT(syAll?"soon":"all"))}</button></div>`+
+    (show.length?`<div class="sy-row${syAll?" all":""}">${show.map(x=>syCard(x.r,x.inn)).join("")}</div>`:`<div class="sy-none">${escH(SYT("none"))}</div>`)+
+    `<div class="sy-src">${escH(SYT("src"))}: <a href="${escH(window.SUSAN.blog||"http://www.cupcakesandcrablegs.com")}" target="_blank" rel="noopener sponsored">cupcakesandcrablegs.com</a></div>`;
+  el.querySelector(".sy-all").onclick=()=>{ syAll=!syAll; renderSusan(); };
+  el.querySelectorAll(".sy-open").forEach(b=>b.onclick=()=>open(b.dataset.id));
+}
