+/* ---------- Susan York's latest reviews (20 Nov 2026): the ones open now or opening within two hours; all ten on request ---------- */
+// from /page5/susan.js (window.SUSAN.latest, newest first). A place on this site uses its own hours; one that is not uses the
+// hours her post gives (marked: worth confirming); with no hours it is shown only in "All 10".
+const SY=(window.SUSAN&&window.SUSAN.latest)||[];
+SY.forEach((r,i)=>{ r.key=r.id||(r.hours?"sy"+i:null); if(!r.id&&r.hours) HOURS[r.key]=r.hours; });
+const SYS={ "head":["Susan York’s latest reviews","Las reseñas más recientes de Susan York"],
+  "sub":["Open now or opening within two hours","Abiertos ahora o que abren en las próximas dos horas"],
+  "suball":["All ten, newest first","Las diez, de la más reciente a la más antigua"],
+  "all":["All 10","Las 10"], "soon":["Only open soon","Solo las que abren pronto"],
+  "none":["None of her ten latest is open now or opens in the next two hours.","Ninguna de sus diez más recientes está abierta ahora ni abre en las próximas dos horas."],
+  "opens":["Opens at {t} · in {m}","Abre a las {t} · en {m}"], "nohours":["Hours not on our site","Horario no disponible en el sitio"],
+  "fromPost":["Hours from her post, worth confirming","Horario según su reseña; conviene confirmarlo"],
+  "review":["Her review ↗","Su reseña ↗"], "card":["See the place","Ver el lugar"],
+  "src":["From her blog","De su blog"] };
+const SYT=(k,v)=>{ let s=SYS[k][window.LANG==="es"?1:0]; for(const x in v||{}) s=s.replace("{"+x+"}",v[x]); return s; };
+const hm=m=>{ m%=1440; return Math.floor(m/60)+":"+String(m%60).padStart(2,"0"); };
+const mins=m=>m<60?m+" min":Math.floor(m/60)+" h"+(m%60?" "+(m%60)+" min":"");
+function opensIn(key){ // 0: open now; minutes until it opens, if within two hours; otherwise null
+  if(!key||STATUS[key]) return null; const h=HOURS[key]; if(!h) return null; const n=nowMX();
+  const day=d=>{ const t=h[String((d+7)%7)]; return typeof t==="string"?ranges(t):[]; };
+  for(const [,e] of day(n.d-1)) if(e>1440&&n.m<e-1440) return 0;
+  for(const [s0,e] of day(n.d)) if(n.m>=s0&&n.m<e) return 0;
+  for(const [s0] of day(n.d)) if(s0>n.m&&s0-n.m<=120) return s0-n.m;
+  for(const [s0] of day(n.d+1)) if(s0+1440-n.m<=120) return s0+1440-n.m;
+  return null;
+}
